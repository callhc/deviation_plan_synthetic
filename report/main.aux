\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Daily OD demand matrix $\DOTSB \sum@ \slimits@ _h T^h$ for the test scenario (20 TAZs, 10\,000 daily trips). Rows are origin zones, columns are destination zones. The cell colour and annotation encode the total number of trips. The diagonal is zero by construction (no intra demand). Dense clusters correspond to adjacent zones with high lane-kilometer mass.}}{16}{figure.5}\protected@file@percent }
\newlabel{fig:od_heatmap}{{5}{16}{Daily OD demand matrix $\sum _h T^h$ for the test scenario (20 TAZs, 10\,000 daily trips). Rows are origin zones, columns are destination zones. The cell colour and annotation encode the total number of trips. The diagonal is zero by construction (no intra demand). Dense clusters correspond to adjacent zones with high lane-kilometer mass}{figure.5}{}}
